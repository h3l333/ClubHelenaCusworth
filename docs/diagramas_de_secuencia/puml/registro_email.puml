@startuml
title UC1 - Register with email and password

actor User
participant "login/register_form.dart\n(RegisterForm)" as RF
participant "login_screen.dart\n(LoginScreen)" as LS
participant "login/auth_actions.dart\n(registerWithEmail / _guard)" as AA
participant "services/profile_store.dart\n(ProfileStore)" as PS
participant "FirebaseAuth SDK" as FA
participant "main.dart\n(AuthGate)" as GATE
participant "services/api_client.dart\n(ApiClient)" as API
participant "backend\n(routers/users.py)" as BE
participant "Firebase Admin SDK" as ADMIN
database "Postgres" as DB

User -> RF : fills in name, last name, email, password,\nconfirm password, birth date, DNI\ntaps "Registrarme"
RF -> LS : onSubmit()
LS -> LS : _submit()\n_registerFormKey.validate()

alt invalid form
  LS -> RF : shows field errors
else valid form
  LS -> LS : _setBusy(true)
  LS -> AA : registerWithEmail(...)
  AA -> AA : parseBirthDate(birthDateText)
  AA -> PS : beginRegistration()\n(status = registering)
  AA -> FA : createUserWithEmailAndPassword(email, password)
  FA -> GATE : authStateChanges() emits User
  GATE -> GATE : isRegistering -> keeps LoginScreen
  FA --> AA : UserCredential

  AA -> API : createUser(firstName, lastName, birthDate, dni)
  API -> BE : POST /users\nAuthorization: Bearer <token>
  BE -> ADMIN : verify_id_token(token) (get_firebase_claims)
  ADMIN --> BE : claims (uid, email)
  BE -> DB : SELECT user WHERE firebase_uid = uid
  BE -> DB : SELECT user WHERE dni = body.dni

  alt uid or DNI already registered
    BE --> API : 409 El usuario ya existe / El DNI ya esta registrado
  else ok
    BE -> DB : INSERT user (firebase_uid, email, names, birth_date, dni)
    BE -> DB : COMMIT
    BE --> API : 201 UserOut
  end

  alt 201
    API --> AA : UserProfile
    AA -> PS : setProfile(profile)\n(status = ready)
    AA --> LS : null (success)
    ref over GATE, PS : UC5 - ver_home.puml (AuthGate -> ProfileGate -> HomeScreen)
  else error (409, FirebaseAuthException, FormatException, no connection)
    AA -> FA : user.delete()\n(or signOut() if delete fails)
    AA -> PS : cancelRegistration()\n(status = idle)
    AA -> AA : translateAuthError / ApiException.message
    AA --> LS : error message
    LS -> RF : _showError(message)
  end
  LS -> LS : _setBusy(false)
end
@enduml
