@startuml
title Google sign-in

actor User
participant "login_screen.dart\n(LoginScreen)" as LS
participant "login/google_auth.dart\n(GoogleAuthService)" as GA
participant "google_sign_in plugin\n(Android Credential Manager)" as GSI
participant "Google Identity" as GOOGLE
participant "FirebaseAuth SDK" as FA
participant "Firebase Auth\n(servidor)" as FAS
participant "main.dart\n(AuthGate / ProfileGate)" as GATE
participant "services/profile_store.dart\n(ProfileStore)" as PS
participant "services/api_client.dart\n(ApiClient)" as API
participant "backend\n(deps.py / firebase.py / routers/users.py)" as BE
participant "Firebase Admin SDK" as ADMIN
database "Postgres" as DB
participant "complete_profile_screen.dart" as CPS
participant "home_screen.dart" as HS
participant "services/push_service.dart" as PUSH

== Init ==
LS -> GA : init()
GA -> GSI : initialize(serverClientId = Web client ID)

== Sign in ==
User -> LS : taps "Continuar con Google"
LS -> GA : signIn()
GA -> LS : onBusy(true)
GA -> GSI : authenticate()
GSI -> GOOGLE : account picker + consent\n(checks package name + SHA-1)
GOOGLE --> GSI : Google idToken
GSI --> GA : account (idToken)
GA -> FA : signInWithCredential(GoogleAuthProvider.credential(idToken))
FA -> FAS : exchange Google idToken
FAS --> FA : Firebase user + Firebase ID token
FA --> GA : UserCredential
GA -> LS : onBusy(false)

alt GoogleSignInException / FirebaseAuthException
  GA -> LS : onError(message)
end

== Routing ==
FA -> GATE : authStateChanges() emits User
GATE -> GATE : show ProfileGate
GATE -> PS : load()
PS -> API : getMe()
API -> FA : currentUser.getIdToken()
FA --> API : Firebase ID token
API -> BE : GET /users/me\nAuthorization: Bearer <token>
BE -> ADMIN : verify_id_token(token)
ADMIN --> BE : claims (uid, email)
BE -> DB : SELECT user WHERE firebase_uid = uid

alt profile exists
  DB --> BE : user
  BE --> API : 200 UserOut
  API --> PS : UserProfile
  PS -> GATE : status = ready
  GATE -> HS : show HomeScreen
else first Google sign-in (no profile)
  DB --> BE : none
  BE --> API : 404 Perfil no encontrado
  API --> PS : ApiException (isNotFound)
  PS -> GATE : status = notFound
  GATE -> CPS : show CompleteProfileScreen
  User -> CPS : fills in name, DNI, birth date
  CPS -> API : createUser(...)
  API -> BE : POST /users + Bearer token
  BE -> ADMIN : verify_id_token(token)
  ADMIN --> BE : claims
  BE -> DB : INSERT user (firebase_uid, email, ...)
  BE --> API : 201 UserOut
  API --> CPS : UserProfile
  CPS -> PS : setProfile(profile)
  PS -> GATE : status = ready
  GATE -> HS : show HomeScreen
end

alt 401 (token expired)
  API -> FA : getIdToken(forceRefresh)
  API -> BE : retry once
end

== After login ==
HS -> PUSH : init()
PUSH -> API : registerDeviceToken(FCM token)
API -> BE : POST device token
@enduml