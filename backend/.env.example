DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sports_club
# Full service account JSON (Firebase console -> Project settings -> Service accounts), on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated list of allowed CORS origins (only needed for web).
CORS_ORIGINS=
# Optional overrides (defaults shown).
# CLUB_TIMEZONE=America/Argentina/Buenos_Aires
# OPEN_HOUR=8
# CLOSE_HOUR=23
# MAX_BOOKING_DAYS_AHEAD=60
